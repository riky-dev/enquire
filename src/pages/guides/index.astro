---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { guideCategories, guideCategoryIcons } from "../../categories";

const guides = await getCollection("guides");

// Group guides by category
const groupedGuides = guideCategories.reduce((acc, cat) => {
  acc[cat] = guides.filter((guide) => guide.data.category === cat);
  return acc;
}, {} as Record<typeof guideCategories[number], typeof guides>);

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout
  title="Relocation Guides"
  description="Step-by-step practical guides, cross-border tips, and CERN hacks for newcomers."
>
  <div class="guides-container">
    <div class="guides-header">
      <h1>Relocation Guides</h1>
      <p class="subtitle">
        Step-by-step instructions, cross-border logistics, and practical CERN hacks curated by the community.
      </p>
    </div>

    {
      guides.length === 0 ? (
        <div class="empty-state">
          <p>No guides found yet. Suggest one or contribute a guide!</p>
          <a href="/suggest" class="suggest-btn" id="btn-suggest-guide-empty">
            Suggest a Guide
          </a>
        </div>
      ) : (
        <div class="categories-list">
          {guideCategories.map((cat) => {
            const catGuides = groupedGuides[cat];
            if (catGuides.length === 0) return null;

            return (
              <section class="category-section" aria-labelledby={`cat-${cat.replace(/\s+/g, "-").toLowerCase()}`}>
                <div class="category-title-wrapper">
                  <span class="category-icon">{guideCategoryIcons[cat]}</span>
                  <h2 class="category-title" id={`cat-${cat.replace(/\s+/g, "-").toLowerCase()}`}>{cat}</h2>
                  <span class="category-count">{catGuides.length} {catGuides.length === 1 ? 'guide' : 'guides'}</span>
                </div>

                <div class="guides-grid">
                  {catGuides.map((guide) => (
                    <a
                      href={`/guides/${guide.id}`}
                      class="guide-card"
                      id={`guide-card-${guide.id}`}
                    >
                      <div class="card-header">
                        <span class="category-tag">{guide.data.category}</span>
                        <span class="update-date">Updated {formatDate(guide.data.lastUpdated)}</span>
                      </div>
                      <h3 class="card-title">{guide.data.title}</h3>
                      <p class="card-description">{guide.data.description}</p>
                      <div class="card-footer">
                        <span class="read-link">Read Guide <span class="arrow">→</span></span>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      )
    }
  </div>
</Layout>

<style>
  .guides-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .guides-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  h1 {
    font-size: 3rem;
    font-weight: 800;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .categories-list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .category-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .category-title-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .category-icon {
    font-size: 1.5rem;
  }

  .category-title {
    font-size: 1.5rem;
    font-weight: 750;
    color: var(--text-primary);
  }

  .category-count {
    font-size: 0.8rem;
    font-weight: 600;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    color: var(--text-secondary);
    margin-left: 0.5rem;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  .guide-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background-image: radial-gradient(
      circle at top right,
      rgba(139, 92, 246, 0.02) 0%,
      transparent 50%
    );
    text-decoration: none;
    cursor: pointer;
  }

  .guide-card:hover {
    transform: translateY(-5px);
    border-color: rgba(139, 92, 246, 0.4);
    box-shadow: 0 12px 30px rgba(139, 92, 246, 0.12);
  }

  .guide-card:hover .card-title {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .guide-card:hover .read-link {
    color: var(--text-primary);
  }

  .guide-card:hover .read-link .arrow {
    transform: translateX(4px);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .category-tag {
    color: var(--accent-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .update-date {
    color: var(--text-secondary);
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .card-description {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.5rem;
    flex-grow: 1;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--border-color);
  }

  .read-link {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: color 0.2s ease;
  }

  .read-link .arrow {
    transition: transform 0.2s ease;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 20px;
  }

  .empty-state p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .suggest-btn {
    display: inline-block;
    background: var(--accent-gradient);
    color: white;
    text-decoration: none;
    padding: 0.75rem 2rem;
    border-radius: 10px;
    font-weight: 700;
    transition: transform 0.2s ease;
  }

  .suggest-btn:hover {
    transform: scale(1.02);
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2.25rem;
    }
    .guides-grid {
      grid-template-columns: 1fr;
    }
    .category-title-wrapper {
      flex-wrap: wrap;
    }
  }
</style>
