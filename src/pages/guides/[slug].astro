---
import { getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Giscus from "@components/Giscus.astro";
import { guideCategoryIcons } from "@/categories";
import { formatDate } from "@/utils/helpers";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, category, description, lastUpdated } = entry.data;

const { Content } = await render(entry);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description: description,
  image: new URL("/favicon.svg", Astro.url).href,
  dateModified: lastUpdated,
  datePublished: lastUpdated,
  publisher: {
    "@type": "Organization",
    name: "Enquire",
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", Astro.url).href,
    },
  },
  author: {
    "@type": "Organization",
    name: "Enquire",
  },
  articleBody: entry.body,
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <div class="detail-container">
    <!-- Back Link -->
    <a href="/guides" class="back-link" id="btn-back-to-guides">
      <span class="arrow">←</span> Back to Guides
    </a>

    <!-- Detail Header -->
    <article class="guide-article">
      <header class="guide-header">
        <div class="header-badges">
          <span class="category-badge">
            <span class="badge-icon">{guideCategoryIcons[category]}</span>
            {category}
          </span>
          <span class="date-badge">Updated: {formatDate(lastUpdated)}</span>
        </div>
        <h1>{title}</h1>
        {description && <p class="lead-description">{description}</p>}
      </header>

      <!-- Main Markdown Content -->
      <section class="content-card" aria-label="Guide Content">
        <div class="markdown-content prose">
          <Content />
        </div>
      </section>
    </article>

    <!-- Suggest a Guide Box -->
    <div class="suggest-guide-box">
      <p class="suggest-guide-text">Have a relocation tip or another guide suggestion?</p>
      <a href="/suggest" class="suggest-guide-btn" id="btn-suggest-guide-detail">
        Suggest a Guide
      </a>
    </div>

    <!-- Giscus Comments Section -->
    <div class="comments-section">
      <h2 class="comments-title">Community Input & Corrections</h2>
      <p class="comments-desc">
        Did something change or is there a schedule update? Let the community know in the comments
        below!
      </p>
      <Giscus />
    </div>
  </div>
</Layout>

<style>
  .detail-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s ease;
    align-self: flex-start;
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  .back-link .arrow {
    transition: transform 0.2s ease;
  }

  .back-link:hover .arrow {
    transform: translateX(-3px);
  }

  /* Header Styling */
  .guide-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .header-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .category-badge {
    font-size: 0.75rem;
    font-weight: 700;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    padding: 0.3rem 0.8rem;
    border-radius: 8px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .date-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px dashed var(--border-color);
    padding: 0.3rem 0.8rem;
    border-radius: 8px;
  }

  h1 {
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: 0;
  }

  .lead-description {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Content Card */
  .content-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: none;
  }

  /* Suggest Guide Box Styling */
  .suggest-guide-box {
    background-color: var(--bg-secondary);
    border: 1px dashed var(--border-color);
    border-radius: 8px;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .suggest-guide-text {
    color: var(--text-secondary);
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .suggest-guide-btn {
    display: inline-block;
    background: var(--accent-primary);
    color: var(--bg-primary);
    text-decoration: none;
    padding: 0.6rem 1.5rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.9rem;
    transition: background-color 0.2s ease;
    text-align: center;
  }

  .suggest-guide-btn:hover {
    background: var(--accent-hover);
  }

  /* Comments Styling */
  .comments-section {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: none;
  }

  .comments-title {
    font-size: 1.4rem;
    font-weight: 750;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .comments-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.25rem;
    }

    .content-card,
    .comments-section {
      padding: 1.5rem;
    }
  }
</style>
