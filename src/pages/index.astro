---
import Layout from "@layouts/Layout.astro";
---

<Layout
  title="Unofficial CERN Relocation Guide & Directory"
  description="An unofficial onboarding companion and directory for CERN newcomers, interns, and students. Discover local services, cross-border banking, housing tips, and campus hacks."
>
  <div class="page-wrapper">
    <div class="hero-section">
      <h1>Enquire</h1>
      <p class="description">
        An unofficial onboarding companion and local directory for short-term interns, students, and
        employees relocating to the Geneva/Pays de Gex cross-border region.
      </p>
      <div class="cta-buttons">
        <a href="/services" class="cta-button primary-cta" id="cta-view-directory">
          Browse Services
        </a>
        <a href="/guides" class="cta-button secondary-cta" id="cta-view-guides"> Read Guides </a>
      </div>
    </div>

    <section class="entry-section" aria-label="Browse Enquire">
      <a href="/services" class="entry-link">
        <span class="entry-label">Services</span>
        <p>
          English-friendly local providers, addresses, languages, and newcomer notes for the Geneva
          and Pays de Gex area.
        </p>
      </a>

      <a href="/guides" class="entry-link">
        <span class="entry-label">Guides</span>
        <p>
          Practical steps for housing, banking, health insurance, transport, paperwork, and campus
          life.
        </p>
      </a>
    </section>
  </div>
</Layout>

<style>
  .page-wrapper {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .hero-section {
    text-align: left;
    border-bottom: 1px solid var(--border-color);
    padding: 4rem 0 3rem;
  }

  h1 {
    font-size: 3.75rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: 0;
  }

  .description {
    color: var(--text-secondary);
    font-size: 1.2rem;
    max-width: 650px;
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  .cta-buttons {
    display: flex;
    justify-content: flex-start;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-block;
    padding: 0.85rem 1.4rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 8px;
    font-size: 0.98rem;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .primary-cta {
    background: var(--accent-primary);
    color: var(--bg-primary);
    border: 1px solid var(--accent-primary);
  }

  .primary-cta:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .secondary-cta {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }

  .secondary-cta:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--border-strong);
  }

  .entry-section {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .entry-link {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.5rem;
    box-shadow: none;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .entry-link:hover {
    background-color: var(--bg-tertiary);
    border-color: var(--border-strong);
  }

  .entry-label {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .entry-link p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2.75rem;
    }
    .hero-section {
      padding: 2.75rem 0 2.25rem;
    }
    .cta-buttons {
      flex-direction: column;
      width: 100%;
    }
    .cta-button {
      width: 100%;
      text-align: center;
    }
    .entry-section {
      grid-template-columns: 1fr;
    }
  }
</style>
