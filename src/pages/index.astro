---
import Layout from "../layouts/Layout.astro";
import FormEmbed from "../components/FormEmbed.astro";
import Giscus from "../components/Giscus.astro";
import { siteConfig } from "../config";
---

<Layout title="Unofficial CERN Relocation Guide & Directory">
  <div class="page-wrapper">
    <div class="hero-section">
      <h1>Enquire</h1>
      <p class="description">
        An unofficial onboarding companion and local directory for short-term interns, students, and employees relocating to the Geneva/Pays de Gex cross-border region.
      </p>
      <div class="cta-buttons">
        <a href="/services" class="cta-button primary-cta" id="cta-view-directory">
          Browse Services
        </a>
        <a href="/suggest" class="cta-button secondary-cta" id="cta-suggest-place">
          Suggest a Place
        </a>
      </div>
    </div>
    
    <section class="features-section" aria-label="Key Features">
      <div class="feature-card">
        <h3>Interactive Directory</h3>
        <p>A catalog of local service providers (barbers, mechanics, repairs) with language details and online booking info.</p>
      </div>

      <div class="feature-card">
        <h3>CERN Hacks</h3>
        <p>Mentions of CERN-specific resources (e.g. self-tyre mounting machines) and practical cross-border tips.</p>
      </div>

      <div class="feature-card">
        <h3>Community Reviews</h3>
        <p>Integrates Giscus discussions so newcomers can read, write, and correct reviews on services or guides.</p>
      </div>
    </section>

    <Giscus />
  </div>
</Layout>

<style>
  .page-wrapper {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .hero-section {
    text-align: center;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 5rem 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    background-image: radial-gradient(circle at top right, rgba(6, 182, 212, 0.05) 0%, transparent 40%),
                      radial-gradient(circle at bottom left, rgba(139, 92, 246, 0.05) 0%, transparent 40%);
  }

  h1 {
    font-size: 4rem;
    font-weight: 800;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
  }

  .description {
    color: var(--text-secondary);
    font-size: 1.3rem;
    max-width: 650px;
    margin: 0 auto 3rem auto;
    line-height: 1.6;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-block;
    padding: 0.9rem 2.25rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 12px;
    font-size: 1.05rem;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .primary-cta {
    background: var(--accent-gradient);
    color: #ffffff;
    box-shadow: 0 4px 20px rgba(139, 92, 246, 0.25);
  }

  .primary-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(139, 92, 246, 0.4);
  }

  .secondary-cta {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }

  .secondary-cta:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .features-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139, 92, 246, 0.2);
  }

  .feature-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .feature-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 3rem;
    }
    .hero-section {
      padding: 3.5rem 1.5rem;
    }
    .cta-buttons {
      flex-direction: column;
      width: 100%;
    }
    .cta-button {
      width: 100%;
      text-align: center;
    }
  }
</style>

