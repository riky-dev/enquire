---
import { getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Giscus from "@components/Giscus.astro";
import { formatCategory, hasEnglishSpoken, formatWebsite } from "@/utils/helpers";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, category, address, languages, tags, phone, website } = entry.data;

const { Content } = await render(entry);

const hasEnglish = hasEnglishSpoken(languages);

const formattedWebsite = formatWebsite(website);

const schemaTypes: Record<string, string> = {
  barbers: "BarberShop",
  "car-repair": "AutoRepair",
  "bicycle-repair": "BicycleStore",
};
const schemaType = schemaTypes[category] || "LocalBusiness";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": schemaType,
  name: title,
  address: {
    "@type": "PostalAddress",
    streetAddress: address,
  },
  telephone: phone || undefined,
  url: formattedWebsite || undefined,
};
---

<Layout
  title={title}
  description={`Details and newcomer hacks for ${title} (${formatCategory(category)})`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <div class="detail-container">
    <!-- Back Link -->
    <a href="/services" class="back-link" id="btn-back-to-directory">
      <span class="arrow">←</span> Back to Directory
    </a>

    <!-- Detail Header -->
    <div class="detail-header">
      <div class="header-badges">
        <span class="category-badge">{formatCategory(category)}</span>
        {hasEnglish && <span class="english-badge">English Spoken</span>}
      </div>
      <h1>{title}</h1>
    </div>

    <!-- Main Grid Layout -->
    <div class="detail-grid">
      <!-- Left: Markdown Content / Description -->
      <section class="content-card" aria-label="Service Details">
        <h2 class="section-title">Newcomer Review & Hacks</h2>
        <div class="markdown-content prose">
          <Content />
        </div>
      </section>

      <!-- Right: Structured Information Card -->
      <aside class="info-card" aria-label="Contact Information">
        <h2 class="card-section-title">Contact & Location</h2>

        <div class="info-items">
          <div class="info-item">
            <div class="info-details">
              <span class="info-label">Address</span>
              <p class="info-value">{address}</p>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="maps-link"
                id="link-google-maps"
              >
                Open in Google Maps ↗
              </a>
            </div>
          </div>

          {
            phone && (
              <div class="info-item">
                <div class="info-details">
                  <span class="info-label">Phone</span>
                  <a href={`tel:${phone}`} class="info-value link-value" id="link-phone">
                    {phone}
                  </a>
                </div>
              </div>
            )
          }

          {
            website && (
              <div class="info-item">
                <div class="info-details">
                  <span class="info-label">Website</span>
                  <a
                    href={formattedWebsite}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="info-value link-value website-link"
                    id="link-website"
                  >
                    Visit Website ↗
                  </a>
                </div>
              </div>
            )
          }

          <div class="info-item">
            <div class="info-details">
              <span class="info-label">Languages Spoken</span>
              <div class="languages-tags">
                {languages.map((lang) => <span class="lang-tag">{lang}</span>)}
              </div>
            </div>
          </div>
        </div>

        {
          tags.length > 0 && (
            <div class="tags-section">
              <span class="info-label">Attributes</span>
              <div class="tags-list">
                {tags.map((tag) => (
                  <span class="tag-badge">#{tag}</span>
                ))}
              </div>
            </div>
          )
        }

        <div class="suggest-section">
          <span class="info-label">Contribute</span>
          <p class="suggest-text">Know another great local place?</p>
          <a href="/suggest" class="suggest-link-btn" id="btn-suggest-from-detail">
            Suggest a Place
          </a>
        </div>
      </aside>
    </div>

    <!-- Giscus Comments Section -->
    <div class="comments-section">
      <h2 class="comments-title">Community Reviews & Suggestions</h2>
      <p class="comments-desc">
        Have you visited this place? Leave a review or add helpful tips/hacks below to help other
        CERN newcomers!
      </p>
      <Giscus />
    </div>
  </div>
</Layout>

<style>
  .detail-container {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s ease;
    align-self: flex-start;
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  .back-link .arrow {
    transition: transform 0.2s ease;
  }

  .back-link:hover .arrow {
    transform: translateX(-3px);
  }

  /* Header Styling */
  .detail-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .header-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .category-badge {
    font-size: 0.75rem;
    font-weight: 700;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    padding: 0.3rem 0.8rem;
    border-radius: 8px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .english-badge {
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(78, 163, 216, 0.12);
    border: 1px solid rgba(78, 163, 216, 0.26);
    color: var(--accent-primary);
    padding: 0.3rem 0.8rem;
    border-radius: 8px;
  }

  h1 {
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: 0;
  }

  /* Grid Layout */
  .detail-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* Left Column (Markdown content) */
  .content-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: none;
    min-height: 300px;
  }

  .section-title {
    font-size: 1.4rem;
    font-weight: 750;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  /* Right Column (Info Card) */
  .info-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 90px; /* Offset to float nicely alongside sticky header */
  }

  .card-section-title {
    font-size: 1.2rem;
    font-weight: 750;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .info-items {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .info-icon {
    font-size: 1.25rem;
    margin-top: 0.1rem;
    flex-shrink: 0;
  }

  .info-details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .info-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .info-value {
    font-size: 0.95rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .link-value {
    text-decoration: none;
    font-weight: 600;
    color: var(--accent-primary);
    transition: color 0.2s ease;
    align-self: flex-start;
  }

  .link-value:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .maps-link {
    font-size: 0.85rem;
    color: var(--accent-primary);
    text-decoration: none;
    font-weight: 600;
    margin-top: 0.2rem;
    transition: color 0.2s ease;
    align-self: flex-start;
  }

  .maps-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .languages-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .lang-tag {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .tags-section {
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-badge {
    color: var(--accent-secondary);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .suggest-section {
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .suggest-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .suggest-link-btn {
    display: inline-block;
    text-align: center;
    background: var(--accent-primary);
    color: var(--bg-primary);
    text-decoration: none;
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.9rem;
    transition: background-color 0.2s ease;
    margin-top: 0.25rem;
  }

  .suggest-link-btn:hover {
    background: var(--accent-hover);
  }

  /* Comments Styling */
  .comments-section {
    margin-top: 2rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: none;
  }

  .comments-title {
    font-size: 1.4rem;
    font-weight: 750;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .comments-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }

    .info-card {
      position: static;
    }

    h1 {
      font-size: 2.25rem;
    }

    .content-card,
    .info-card,
    .comments-section {
      padding: 1.5rem;
    }
  }
</style>
