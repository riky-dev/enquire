---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Giscus from "../../components/Giscus.astro";
import { serviceCategories } from "../../categories";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, category, address, languages, tags, phone, website } = entry.data;

const { Content } = await render(entry);

const hasEnglish = languages.some(
  (lang) => lang.toLowerCase() === "english"
);

const formattedWebsite = website && !/^https?:\/\//i.test(website) 
  ? `https://${website}` 
  : website;

function formatCategory(cat: string) {
  if (serviceCategories[cat]) return serviceCategories[cat];
  return cat
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}
---

<Layout title={title} description={`Details and newcomer hacks for ${title} (${formatCategory(category)})`}>
  <div class="detail-container">
    <!-- Back Link -->
    <a href="/services" class="back-link" id="btn-back-to-directory">
      <span class="arrow">←</span> Back to Directory
    </a>

    <!-- Detail Header -->
    <div class="detail-header">
      <div class="header-badges">
        <span class="category-badge">{formatCategory(category)}</span>
        {hasEnglish && (
          <span class="english-badge">English Spoken</span>
        )}
      </div>
      <h1>{title}</h1>
    </div>

    <!-- Main Grid Layout -->
    <div class="detail-grid">
      <!-- Left: Markdown Content / Description -->
      <section class="content-card" aria-label="Service Details">
        <h2 class="section-title">Newcomer Review & Hacks</h2>
        <div class="markdown-content">
          <Content />
        </div>
      </section>

      <!-- Right: Structured Information Card -->
      <aside class="info-card" aria-label="Contact Information">
        <h2 class="card-section-title">Contact & Location</h2>
        
        <div class="info-items">
          <div class="info-item">
            <div class="info-details">
              <span class="info-label">Address</span>
              <p class="info-value">{address}</p>
              <a 
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="maps-link"
                id="link-google-maps"
              >
                Open in Google Maps ↗
              </a>
            </div>
          </div>

          {phone && (
            <div class="info-item">
              <div class="info-details">
                <span class="info-label">Phone</span>
                <a href={`tel:${phone}`} class="info-value link-value" id="link-phone">
                  {phone}
                </a>
              </div>
            </div>
          )}

          {website && (
            <div class="info-item">
              <div class="info-details">
                <span class="info-label">Website</span>
                <a 
                  href={formattedWebsite} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="info-value link-value website-link"
                  id="link-website"
                >
                  Visit Website ↗
                </a>
              </div>
            </div>
          )}

          <div class="info-item">
            <div class="info-details">
              <span class="info-label">Languages Spoken</span>
              <div class="languages-tags">
                {languages.map((lang) => (
                  <span class="lang-tag">{lang}</span>
                ))}
              </div>
            </div>
          </div>
        </div>

        {tags.length > 0 && (
          <div class="tags-section">
            <span class="info-label">Attributes</span>
            <div class="tags-list">
              {tags.map((tag) => (
                <span class="tag-badge">#{tag}</span>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>

    <!-- Giscus Comments Section -->
    <div class="comments-section">
      <h2 class="comments-title">Community Reviews & Suggestions</h2>
      <p class="comments-desc">
        Have you visited this place? Leave a review or add helpful tips/hacks below to help other CERN newcomers!
      </p>
      <Giscus />
    </div>
  </div>
</Layout>

<style>
  .detail-container {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s ease;
    align-self: flex-start;
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  .back-link .arrow {
    transition: transform 0.2s ease;
  }

  .back-link:hover .arrow {
    transform: translateX(-3px);
  }

  /* Header Styling */
  .detail-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .header-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .category-badge {
    font-size: 0.75rem;
    font-weight: 700;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    padding: 0.3rem 0.8rem;
    border-radius: 8px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .english-badge {
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.2);
    color: #22d3ee;
    padding: 0.3rem 0.8rem;
    border-radius: 8px;
  }

  h1 {
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  /* Grid Layout */
  .detail-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* Left Column (Markdown content) */
  .content-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    min-height: 300px;
  }

  .section-title {
    font-size: 1.4rem;
    font-weight: 750;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .markdown-content {
    color: var(--text-primary);
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .markdown-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .markdown-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .markdown-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  /* Right Column (Info Card) */
  .info-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 90px; /* Offset to float nicely alongside sticky header */
  }

  .card-section-title {
    font-size: 1.2rem;
    font-weight: 750;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .info-items {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .info-icon {
    font-size: 1.25rem;
    margin-top: 0.1rem;
    flex-shrink: 0;
  }

  .info-details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .info-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .info-value {
    font-size: 0.95rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .link-value {
    text-decoration: none;
    font-weight: 600;
    color: #a78bfa;
    transition: color 0.2s ease;
    align-self: flex-start;
  }

  .link-value:hover {
    color: #c084fc;
    text-decoration: underline;
  }

  .maps-link {
    font-size: 0.85rem;
    color: var(--accent-secondary);
    text-decoration: none;
    font-weight: 600;
    margin-top: 0.2rem;
    transition: color 0.2s ease;
    align-self: flex-start;
  }

  .maps-link:hover {
    color: #22d3ee;
    text-decoration: underline;
  }

  .languages-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .lang-tag {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .tags-section {
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-badge {
    color: var(--accent-secondary);
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Comments Styling */
  .comments-section {
    margin-top: 2rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .comments-title {
    font-size: 1.4rem;
    font-weight: 750;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .comments-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }

    .info-card {
      position: static;
    }

    h1 {
      font-size: 2.25rem;
    }

    .content-card, .info-card, .comments-section {
      padding: 1.5rem;
    }
  }
</style>
