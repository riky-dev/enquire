---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { serviceCategories } from "../../categories";

const services = await getCollection("services");

// Extract all unique categories
const categories = [...new Set(services.map((service) => service.data.category))];

function formatCategory(cat: string) {
  if (serviceCategories[cat]) return serviceCategories[cat];
  return cat
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}
---

<Layout
  title="Services Directory"
  description="Browse English-speaking and CERN-recommended local service providers in the Swiss-French border area."
>
  <div class="directory-container">
    <div class="directory-header">
      <h1>Services Directory</h1>
      <p class="subtitle">
        Find community-curated, English-friendly local services and practical tips for the Pays de
        Gex and Geneva area.
      </p>
    </div>

    <!-- Category Filter Controls -->
    {
      categories.length > 0 && (
        <div class="filter-wrapper">
          <span class="filter-label">Filter by Category:</span>
          <div class="filter-buttons" role="group" aria-label="Category Filters">
            <button class="filter-btn active" data-category="all" id="filter-btn-all">
              All Services
            </button>
            {categories.map((cat) => (
              <button class="filter-btn" data-category={cat} id={`filter-btn-${cat}`}>
                {formatCategory(cat)}
              </button>
            ))}
          </div>
        </div>
      )
    }

    {
      services.length === 0 ? (
        <div class="empty-state">
          <p>No services found. Be the first to suggest one!</p>
          <a href="/suggest" class="suggest-btn" id="btn-suggest-empty">
            Suggest a Place
          </a>
        </div>
      ) : (
        <div class="services-grid" id="services-list">
          {services.map((service) => {
            const hasEnglish = service.data.languages.some(
              (lang) => lang.toLowerCase() === "english",
            );

            return (
              <a
                href={`/services/${service.id}`}
                class="service-card"
                data-category={service.data.category}
                id={`service-card-${service.id}`}
              >
                <div class="card-header">
                  <span class="category-badge">{formatCategory(service.data.category)}</span>
                  {hasEnglish && (
                    <span class="english-badge" title="English Spoken">
                      English Spoken
                    </span>
                  )}
                </div>

                <h2 class="card-title">{service.data.title}</h2>

                <p class="card-address">{service.data.address}</p>

                <div class="card-languages">
                  <span class="label">Languages:</span>
                  <div class="languages-list">
                    {service.data.languages.map((lang) => (
                      <span class="lang-tag">{lang}</span>
                    ))}
                  </div>
                </div>

                {service.data.tags.length > 0 && (
                  <div class="card-tags">
                    {service.data.tags.map((tag) => (
                      <span class="tag-badge">#{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</Layout>

<script>
  // Client-side category filtering
  const filterButtons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".service-card");

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      // Remove active class from all buttons and add to the clicked one
      filterButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      const selectedCategory = btn.getAttribute("data-category");

      cards.forEach((card) => {
        const cardCategory = card.getAttribute("data-category");
        const element = card as HTMLElement;

        if (selectedCategory === "all" || cardCategory === selectedCategory) {
          element.style.display = "flex";
          // Small transition helper
          element.style.opacity = "0";
          element.style.transform = "translateY(8px)";

          requestAnimationFrame(() => {
            element.style.transition = "opacity 0.3s ease, transform 0.3s ease";
            element.style.opacity = "1";
            element.style.transform = "translateY(0)";
          });
        } else {
          element.style.display = "none";
        }
      });
    });
  });
</script>

<style>
  .directory-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .directory-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  h1 {
    font-size: 3rem;
    font-weight: 800;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Filter Styling */
  .filter-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    background: rgba(18, 22, 32, 0.4);
    border: 1px solid var(--border-color);
    padding: 1.25rem;
    border-radius: 16px;
  }

  .filter-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .filter-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.5rem 1.25rem;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .filter-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .filter-btn.active {
    background: var(--accent-gradient);
    color: #ffffff;
    border-color: transparent;
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.2);
  }

  /* Grid & Card Styling */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  .service-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background-image: radial-gradient(
      circle at top right,
      rgba(139, 92, 246, 0.02) 0%,
      transparent 50%
    );
    text-decoration: none;
    cursor: pointer;
  }

  .service-card:hover {
    transform: translateY(-5px);
    border-color: rgba(139, 92, 246, 0.4);
    box-shadow: 0 12px 30px rgba(139, 92, 246, 0.12);
  }

  .service-card:hover .card-title {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .category-badge {
    font-size: 0.75rem;
    font-weight: 700;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .english-badge {
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.2);
    color: #22d3ee;
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
  }

  .card-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .card-address {
    font-size: 0.9rem;
    color: var(--text-secondary);
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .card-address .icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .card-languages {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9rem;
  }

  .card-languages .label {
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  .languages-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .lang-tag {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--border-color);
  }

  .tag-badge {
    color: var(--accent-secondary);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 20px;
  }

  .empty-state p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .suggest-btn {
    display: inline-block;
    background: var(--accent-gradient);
    color: white;
    text-decoration: none;
    padding: 0.75rem 2rem;
    border-radius: 10px;
    font-weight: 700;
    transition: transform 0.2s ease;
  }

  .suggest-btn:hover {
    transform: scale(1.02);
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2.25rem;
    }
    .services-grid {
      grid-template-columns: 1fr;
    }
    .filter-buttons {
      width: 100%;
    }
    .filter-btn {
      flex-grow: 1;
      text-align: center;
    }
  }
</style>
