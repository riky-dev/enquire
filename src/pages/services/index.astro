---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { formatCategory, hasEnglishSpoken } from "@/utils/helpers";

const services = await getCollection("services");

// Extract all unique categories
const categories = [...new Set(services.map((service) => service.data.category))];
---

<Layout
  title="Services Directory"
  description="Local places around Pays de Gex and Geneva that newcomers actually recommend: barbers, mechanics, dentists, and the rest."
>
  <div class="directory-container">
    <div class="directory-header">
      <h1>Services Directory</h1>
      <p class="subtitle">
        Places people around CERN actually go to, preferably ones where you can get by in English.
      </p>
      <div class="header-actions">
        <a href="/suggest" class="suggest-btn" id="btn-suggest-service-header"> Suggest a Place </a>
      </div>
    </div>

    <!-- Category Filter Controls -->
    {
      categories.length > 0 && (
        <div class="filter-wrapper">
          <span class="filter-label">Filter by Category:</span>
          <div class="filter-buttons" role="group" aria-label="Category Filters">
            <button
              class="filter-btn active"
              data-category="all"
              id="filter-btn-all"
              aria-pressed="true"
            >
              All Services
            </button>
            {categories.map((cat) => (
              <button
                class="filter-btn"
                data-category={cat}
                id={`filter-btn-${cat}`}
                aria-pressed="false"
              >
                {formatCategory(cat)}
              </button>
            ))}
          </div>
        </div>
      )
    }

    {
      services.length === 0 ? (
        <div class="empty-state">
          <p>Nothing listed yet. Know a place worth adding?</p>
          <a href="/suggest" class="suggest-btn" id="btn-suggest-empty">
            Suggest a Place
          </a>
        </div>
      ) : (
        <div class="services-grid" id="services-list">
          {services.map((service) => {
            const hasEnglish = hasEnglishSpoken(service.data.languages);

            return (
              <a
                href={`/services/${service.id}`}
                class="service-card"
                data-category={service.data.category}
                id={`service-card-${service.id}`}
              >
                <div class="card-header">
                  <span class="category-badge">{formatCategory(service.data.category)}</span>
                  {hasEnglish && (
                    <span class="english-badge" title="English Spoken">
                      English Spoken
                    </span>
                  )}
                </div>

                <h2 class="card-title">{service.data.title}</h2>

                <p class="card-address">{service.data.address}</p>

                <div class="card-languages">
                  <span class="label">Languages:</span>
                  <div class="languages-list">
                    {service.data.languages.map((lang) => (
                      <span class="lang-tag">{lang}</span>
                    ))}
                  </div>
                </div>

                {service.data.tags.length > 0 && (
                  <div class="card-tags">
                    {service.data.tags.map((tag) => (
                      <span class="tag-badge">#{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</Layout>

<script>
  const filterButtons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".service-card");
  const valid = new Set([...filterButtons].map((btn) => btn.getAttribute("data-category")));

  function categoryFromUrl() {
    const raw = new URLSearchParams(location.search).get("category");
    return raw && valid.has(raw) ? raw : "all";
  }

  function apply(category: string | null = categoryFromUrl(), push = false) {
    if (!category || !valid.has(category)) category = "all";

    filterButtons.forEach((btn) => {
      const on = btn.getAttribute("data-category") === category;
      btn.classList.toggle("active", on);
      btn.setAttribute("aria-pressed", String(on));
    });

    cards.forEach((card) => {
      const show = category === "all" || card.getAttribute("data-category") === category;
      (card as HTMLElement).style.display = show ? "" : "none";
    });

    if (!push) return;

    const url = new URL(location.href);
    if (category === "all") url.searchParams.delete("category");
    else url.searchParams.set("category", category);
    if (url.href !== location.href) history.pushState(null, "", url);
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => apply(btn.getAttribute("data-category"), true));
  });
  window.addEventListener("popstate", () => apply());
  apply();
</script>

<style>
  .directory-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .directory-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  h1 {
    font-size: 3rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: 0;
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .header-actions {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  /* Filter Styling */
  .filter-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 1.25rem;
    border-radius: 8px;
  }

  .filter-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .filter-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.5rem 1.25rem;
    border-radius: 7px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .filter-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--border-strong);
  }

  .filter-btn.active {
    background: var(--accent-primary);
    color: var(--bg-primary);
    border-color: var(--accent-primary);
    box-shadow: none;
  }

  /* Grid & Card Styling */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  .service-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
    text-decoration: none;
    cursor: pointer;
  }

  .service-card:hover {
    background-color: var(--bg-tertiary);
    border-color: var(--border-strong);
  }

  .service-card:hover .card-title {
    color: var(--accent-primary);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category-badge {
    font-size: 0.75rem;
    font-weight: 700;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .english-badge {
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(78, 163, 216, 0.12);
    border: 1px solid rgba(78, 163, 216, 0.26);
    color: var(--accent-primary);
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
  }

  .card-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .card-address {
    font-size: 0.9rem;
    color: var(--text-secondary);
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .card-address .icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .card-languages {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9rem;
  }

  .card-languages .label {
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  .languages-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .lang-tag {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--border-color);
  }

  .tag-badge {
    color: var(--accent-secondary);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
  }

  .empty-state p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .suggest-btn {
    display: inline-block;
    background: var(--accent-primary);
    color: var(--bg-primary);
    text-decoration: none;
    padding: 0.75rem 2rem;
    border-radius: 8px;
    font-weight: 700;
    transition: background-color 0.2s ease;
  }

  .suggest-btn:hover {
    background: var(--accent-hover);
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2.25rem;
    }
    .services-grid {
      grid-template-columns: 1fr;
    }
    .filter-buttons {
      width: 100%;
    }
    .filter-btn {
      flex-grow: 1;
      text-align: center;
    }
  }
</style>
