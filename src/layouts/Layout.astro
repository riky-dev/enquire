---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import GlobalSearch from "../components/GlobalSearch.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = "Unofficial notes for CERN newcomers: local shops, cross-border admin, and the tips that usually get lost in WhatsApp.",
  ogImage,
  ogType = "website",
  canonicalUrl,
} = Astro.props;
---

<!doctype html>
<html lang="en" style="background-color: #121820; color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#121820" />
    <style is:inline>
      html,
      body {
        background-color: #121820;
        color: #eef3f7;
        color-scheme: dark;
      }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Analytics />
    <title>{title} | Enquire</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl || Astro.url.href} />

    <!-- Fonts Preconnect & Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl || Astro.url.href} />
    <meta property="og:title" content={`${title} | Enquire`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage || new URL("/favicon.svg", Astro.url).href} />
    <meta property="og:site_name" content="Enquire" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl || Astro.url.href} />
    <meta name="twitter:title" content={`${title} | Enquire`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || new URL("/favicon.svg", Astro.url).href} />
  </head>
  <body>
    <header class="main-header">
      <nav class="nav-container">
        <a href="/" class="logo" id="nav-logo"> Enquire </a>
        <GlobalSearch />
        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle Navigation">
          <span class="hamburger"></span>
        </label>
        <div class="nav-links">
          <a href="/services" class="nav-link" id="nav-link-services">Services</a>
          <a href="/guides" class="nav-link" id="nav-link-guides">Guides</a>
          <a href="/suggest" class="nav-link" id="nav-link-suggest">Suggest</a>
          <a
            href="https://github.com/riky-dev/enquire"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link github-link"
            id="nav-link-github"
            aria-label="GitHub Repository"
          >
            <svg class="github-icon" viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            <span class="github-text">GitHub</span>
          </a>
        </div>
      </nav>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="main-footer">
      <p class="footer-text">
        Unofficial notes for CERN newcomers. Not affiliated with CERN.<br />Made by <a
          href="https://riky.dev"
          target="_blank"
          rel="noopener noreferrer">riky.dev</a
        >
        · <a href="/about">how?</a>
      </p>
    </footer>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
    align-items: center;
    padding: 0;
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent 320px);
  }

  .main-header {
    width: 100%;
    background-color: rgba(18, 24, 32, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    position: relative;
  }

  .nav-container :global(.search-trigger-desktop) {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
  }

  .logo {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    letter-spacing: 0;
    transition: color 0.2s ease;
  }

  .logo:hover {
    color: var(--accent-primary);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
  }

  .github-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition: color 0.2s ease;
    padding: 0.25rem 0;
  }

  .github-link:hover {
    color: var(--accent-primary);
  }

  .github-link::after {
    display: none !important;
  }

  .github-icon {
    display: block;
  }

  .github-text {
    display: none;
  }

  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
    position: relative;
    padding: 0.25rem 0;
  }

  .nav-link:hover {
    color: var(--accent-primary);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 1px;
    bottom: 0;
    left: 0;
    background: var(--accent-primary);
    transform-origin: bottom right;
    transition: transform 0.25s ease-out;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }

  .main-content {
    flex: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nav-toggle {
    display: none;
  }

  .nav-toggle-label {
    display: none;
  }

  .main-footer {
    width: 100%;
    border-top: 1px solid var(--border-color);
    padding: 2rem;
    text-align: center;
    background-color: rgba(18, 24, 32, 0.76);
  }

  .footer-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .footer-text a {
    color: var(--accent-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .footer-text a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 768px) {
    .nav-container {
      padding: 1rem 1.5rem;
      position: relative;
    }

    .nav-container :global(.search-trigger-mobile) {
      margin-left: auto;
      margin-right: 0.65rem;
    }

    .nav-toggle-label {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      cursor: pointer;
      position: relative;
      z-index: 101;
      flex-shrink: 0;
    }

    .hamburger,
    .hamburger::before,
    .hamburger::after {
      content: "";
      position: absolute;
      width: 20px;
      height: 2px;
      background-color: var(--text-primary);
      transition: all 0.2s ease;
    }

    .hamburger::before {
      transform: translateY(-6px);
    }

    .hamburger::after {
      transform: translateY(6px);
    }

    /* Transform hamburger to X on check */
    #nav-toggle:checked ~ .nav-toggle-label .hamburger {
      background-color: transparent;
    }

    #nav-toggle:checked ~ .nav-toggle-label .hamburger::before {
      transform: rotate(45deg);
    }

    #nav-toggle:checked ~ .nav-toggle-label .hamburger::after {
      transform: rotate(-45deg);
    }

    .nav-links {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background-color: rgba(18, 24, 32, 0.98);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-color);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease-out;
      gap: 0;
      z-index: 99;
    }

    .nav-link {
      padding: 1rem 1.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.02);
      width: 100%;
    }

    .nav-link:last-child {
      border-bottom: none;
    }

    .nav-link::after {
      display: none;
    }

    .github-link {
      justify-content: flex-start;
      gap: 0.75rem;
      padding: 1rem 1.5rem;
      border-bottom: none;
      width: 100%;
    }

    .github-link:hover {
      background-color: rgba(255, 255, 255, 0.02);
    }

    .github-text {
      display: inline;
    }

    #nav-toggle:checked ~ .nav-links {
      max-height: 360px;
    }

    .main-content {
      padding: 2rem 1rem;
    }
  }
</style>
