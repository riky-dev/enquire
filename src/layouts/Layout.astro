---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "An unofficial relocation guide & directory for CERN newcomers, interns, and students." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Enquire</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="main-header">
      <nav class="nav-container">
        <a href="/" class="logo" id="nav-logo">
          Enquire
        </a>
        <div class="nav-links">
          <a href="/" class="nav-link" id="nav-link-home">Home</a>
          <a href="/services" class="nav-link" id="nav-link-services">Services</a>
          <a href="/suggest" class="nav-link" id="nav-link-suggest">Suggest</a>
        </div>
      </nav>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="main-footer">
      <p class="footer-text">
        &copy; {new Date().getFullYear()} Enquire. An unofficial community relocation guide for CERN newcomers.
      </p>
    </footer>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
    align-items: center;
    padding: 0;
    background-image: radial-gradient(circle at top, rgba(139, 92, 246, 0.06) 0%, transparent 50%),
                      radial-gradient(circle at bottom, rgba(6, 182, 212, 0.04) 0%, transparent 50%);
  }

  .main-header {
    width: 100%;
    background-color: rgba(10, 12, 16, 0.7);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 800;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transition: transform 0.2s ease;
  }

  .logo:hover {
    transform: scale(1.02);
  }

  .logo-emoji {
    -webkit-text-fill-color: initial;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s ease, transform 0.2s ease;
    position: relative;
    padding: 0.25rem 0;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 2px;
    bottom: 0;
    left: 0;
    background: var(--accent-gradient);
    transform-origin: bottom right;
    transition: transform 0.25s ease-out;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }

  .main-content {
    flex: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .main-footer {
    width: 100%;
    border-top: 1px solid var(--border-color);
    padding: 2rem;
    text-align: center;
    background-color: rgba(10, 12, 16, 0.5);
  }

  .footer-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 768px) {
    .nav-container {
      padding: 1rem;
    }

    .main-content {
      padding: 2rem 1rem;
    }
  }
</style>
