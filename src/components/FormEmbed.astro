---
interface Props {
  src: string;
  title?: string;
  height?: string;
  width?: string;
  loading?: "lazy" | "eager";
}

const {
  src,
  title = "Submission Form",
  height = "700px",
  width = "100%",
  loading = "lazy",
} = Astro.props;
---

<div class="form-embed-container" style={`max-width: ${width};`}>
  <div class="form-loader">
    <div class="spinner"></div>
    <p class="loader-text">Loading form...</p>
  </div>
  <iframe
    src={src}
    title={title}
    style={`height: ${height}; width: 100%;`}
    loading={loading}
    class="embedded-iframe"
  >
    Loading...
  </iframe>
</div>

<script>
  // Hide loader once the iframe has finished loading
  const iframes = document.querySelectorAll(".embedded-iframe");
  iframes.forEach((iframe) => {
    iframe.addEventListener("load", () => {
      const container = iframe.closest(".form-embed-container");
      if (container) {
        const loader = container.querySelector(".form-loader");
        if (loader) {
          (loader as HTMLElement).style.opacity = "0";
          setTimeout(() => {
            (loader as HTMLElement).style.display = "none";
          }, 300); // Wait for transition to complete
        }
      }
    });
  });
</script>

<style>
  .form-embed-container {
    position: relative;
    width: 100%;
    background-color: transparent;
    border: none;
    border-radius: 8px;
    overflow: hidden;
    margin: 2rem auto;
  }

  .form-loader {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-secondary);
    z-index: 10;
    transition: opacity 0.3s ease;
  }

  .spinner {
    width: 48px;
    height: 48px;
    border: 4px solid rgba(255, 255, 255, 0.05);
    border-top: 4px solid var(--accent-primary);
    border-radius: 50%;
    animation: spin 1s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    margin-bottom: 1rem;
  }

  .loader-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .embedded-iframe {
    display: block;
    border: none;
    background: transparent;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
</style>
